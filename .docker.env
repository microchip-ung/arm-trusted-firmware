MCHP_DOCKER_NAME=$(jq -r '.[] | select(.id == "build-tfa") | .name' .deps.json)
MCHP_DOCKER_TAG=$(jq -r '.[] | select(.id == "build-tfa") | .tag' .deps.json)
MCHP_DOCKER_DIGEST=$(jq -r '.[] | select(.id == "build-tfa") | .sha' .deps.json)

opt=/opt/mscc

if [[ ! -d "$opt" ]]; then
    echo "Directory '$opt' not found!" 1>&2
    exit 1
fi

# Bind mount opt directory 1:1
# Mount /tmp as tmpfs
# Add current username and uid in environment
MCHP_DOCKER_OPTIONS="-v $opt:$opt --tmpfs /tmp:exec -e BLD_USER=$(id -un) -e BLD_UID=$(id -u)"
